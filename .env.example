# ============================================
# JWT - minimo 32 caracteres
# Gere um aleatorio: PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
# ============================================
JWT_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_COM_MINIMO_32_CARACTERES_AQUI
